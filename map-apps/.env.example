# Public browser token only. Never put a secret sk. token in VITE_ variables.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_public_token_here
VITE_COG_SERVER=http://127.0.0.1:8001
VITE_WMS_SERVER=http://127.0.0.1:8002
VITE_METRICS_SERVER=http://127.0.0.1:8004
# Optional browser-wide memory estimate. Requires CORS/CORP-compatible resources.
VITE_ISOLATE_MEMORY=false
